<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="sequence" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <page id="page1">
      <place id="start"><initialMarking><text>1</text></initialMarking></place>
      <place id="middle"/>
      <place id="end"/>
      <transition id="t1"><name><text>Approve</text></name></transition>
      <transition id="t2"><name><text>Approve</text></name></transition>
      <arc id="a1" source="start" target="t1"/>
      <arc id="a2" source="t1" target="middle"/>
      <arc id="a3" source="middle" target="t2"/>
      <arc id="a4" source="t2" target="end"/>
    </page>
    <finalmarkings><marking><place idref="end"><text>1</text></place></marking></finalmarkings>
  </net>
</pnml>
